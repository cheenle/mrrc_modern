{
  "version": 1,
  "description": "Version- and artifact-bearing files for an MRRC Modern release. Consumed by harness/release_check.py (offline rules + optional online publish verification) and enforced by tests/test_release_artifacts.py. Add a rule whenever a new file starts carrying a version, an installer size or a SHA-256 — that is the only way a release stays complete.",
  "app_version_source": {
    "path": "CHANGELOG.md",
    "pattern": "^## \\[(v?[0-9]+\\.[0-9]+\\.[0-9]+)\\]",
    "comment": "The top entry is the single source of truth (packaging/macos/build.sh parses it at build time)."
  },
  "sdd_version_source": {
    "path": "SDD/14-version-history.md",
    "pattern": "^\\|\\s*(?:SDD\\s+)?(V[0-9]+\\.[0-9]+)\\s*\\|",
    "comment": "Newest-first table; the first row is the authoritative SDD version (SDD/README Quick Facts is mirrored from it and checked)."
  },
  "rules": [
    {
      "id": "iss-version",
      "path": "packaging/windows/MRRC-Modern.iss",
      "pattern": "#define MyAppVersion \"([0-9.]+)\"",
      "expect": "app",
      "count": 1,
      "why": "Inno Setup cannot read CHANGELOG; this literal must be kept equal by hand."
    },
    {
      "id": "website-cards-en",
      "path": "website/index.html",
      "pattern": "(?:MRRC-Modern-v|MRRC-Modern-Setup\\.exe — v?)([0-9]+\\.[0-9]+\\.[0-9]+)",
      "expect": "app",
      "min_count": 3,
      "why": "Windows card, macOS card and the versioned-download links all carry the release version."
    },
    {
      "id": "website-cards-zh",
      "path": "website/zh/index.html",
      "pattern": "(?:MRRC-Modern-v|MRRC-Modern-Setup\\.exe — v?)([0-9]+\\.[0-9]+\\.[0-9]+)",
      "expect": "app",
      "min_count": 3
    },
    {
      "id": "website-guide-en",
      "path": "website/guide.html",
      "pattern": "MRRC-Modern-v([0-9]+\\.[0-9]+\\.[0-9]+)-arm64\\.dmg",
      "expect": "app",
      "min_count": 1
    },
    {
      "id": "website-guide-zh",
      "path": "website/zh/guide.html",
      "pattern": "MRRC-Modern-v([0-9]+\\.[0-9]+\\.[0-9]+)-arm64\\.dmg",
      "expect": "app",
      "min_count": 1
    },
    {
      "id": "sdd-badge-en",
      "path": "website/index.html",
      "pattern": "<strong>(V[0-9]+\\.[0-9]+)</strong>",
      "expect": "sdd",
      "count": 1
    },
    {
      "id": "sdd-badge-zh",
      "path": "website/zh/index.html",
      "pattern": "<strong>(V[0-9]+\\.[0-9]+)</strong>",
      "expect": "sdd",
      "count": 1
    },
    {
      "id": "sdd-landing-en",
      "path": "website/sdd.html",
      "pattern": "SDD (V[0-9]+\\.[0-9]+) ·",
      "expect": "sdd",
      "count": 1,
      "why": "Hand-written page — NOT generated by build_sdd.py, so it drifted to V2.27 once."
    },
    {
      "id": "sdd-landing-zh",
      "path": "website/zh/sdd.html",
      "pattern": "SDD (V[0-9]+\\.[0-9]+) ·",
      "expect": "sdd",
      "count": 1
    },
    {
      "id": "sdd-readme-quickfacts",
      "path": "SDD/README.md",
      "pattern": "\\| SDD Version \\| (V[0-9]+\\.[0-9]+) \\|",
      "expect": "sdd",
      "count": 1
    },
    {
      "id": "macos-guide",
      "path": "docs/MACOS_INSTALLER_GUIDE.md",
      "pattern": "MRRC-Modern-v([0-9]+\\.[0-9]+\\.[0-9]+)-arm64\\.dmg",
      "expect": "app",
      "min_count": 1
    },
    {
      "id": "windows-guide",
      "path": "docs/WINDOWS_INSTALLER_GUIDE.md",
      "pattern": "MRRC-Modern-v([0-9]+\\.[0-9]+\\.[0-9]+)-Windows-x64-Setup\\.exe",
      "expect": "app",
      "min_count": 1
    },
    {
      "id": "pi-guide",
      "path": "docs/RASPBERRY_PI_GUIDE.md",
      "pattern": "MRRC-Modern-v([0-9]+\\.[0-9]+\\.[0-9]+)-rpi64\\.img\\.xz",
      "expect": "app",
      "min_count": 1,
      "optional": true,
      "why": "Only present once a Raspberry Pi image has been published."
    }
  ],
  "artifact_facts": [
    {
      "id": "website-macos-card",
      "page": "website/index.html",
      "size_pattern": "([0-9]{2},[0-9]{3},[0-9]{3}) bytes",
      "sha_prefix": "SHA-256 \\| `([0-9a-f]{8})…",
      "artifact": "dist/macos/MRRC-Modern-v{app}-arm64.dmg",
      "why": "The card must quote the bytes/SHA of the artifact that was actually built and uploaded."
    },
    {
      "id": "website-windows-card",
      "page": "website/index.html",
      "size_pattern": "([0-9]{2},[0-9]{3},[0-9]{3}) bytes",
      "sha_prefix": "SHA-256 \\| `([0-9a-f]{8})…",
      "artifact": "dist/windows/MRRC-Modern-v{app}-Windows-x64-Setup.exe"
    }
  ],
  "stale_tokens": {
    "comment": "Current-facing pages must not advertise a previous release's download; historical records are excluded on purpose.",
    "scope": [
      "website/index.html",
      "website/zh/index.html",
      "website/sdd.html",
      "website/zh/sdd.html",
      "website/guide.html",
      "website/zh/guide.html",
      "README.md",
      "docs/MACOS_INSTALLER_GUIDE.md",
      "docs/WINDOWS_INSTALLER_GUIDE.md",
      "docs/OPERATION_GUIDE.md"
    ],
    "pattern": "MRRC-Modern-v([0-9]+\\.[0-9]+\\.[0-9]+)-(?:arm64\\.dmg|Windows-x64-Setup\\.exe|rpi64\\.img\\.xz)",
    "allow_versions": [
      "{app}"
    ],
    "why": "A card still pointing at the previous version's file is the classic 'built but not published' symptom."
  },
  "manual_review": {
    "comment": "Not machine-checkable, listed so the runbook never forgets them. Review each for stale examples after a release.",
    "paths": [
      "mac_pack.md",
      "win_pack.md",
      "pi_pack.md",
      ".agents/skills/dual-platform-release/SKILL.md",
      ".agents/skills/macos-installer/SKILL.md",
      ".agents/skills/windows-installer/SKILL.md",
      "AGENTS.md"
    ]
  },
  "history_only": {
    "comment": "Dated design records and generated pages: never 'updated' to the current version.",
    "paths": [
      "CHANGELOG.md",
      "SDD/14-version-history.md",
      "docs/superpowers/**",
      ".superpowers/**",
      "promo/**",
      "website/sdd/**"
    ]
  },
  "diagrams": {
    "comment": "Design diagrams are artifacts too: each SVG carries a diagram-version marker and the keywords of the capability it depicts, so a feature change fails this check until the picture is updated. The site copies are generated by build_sdd.py / build_guide.py — never edit them by hand. The marker may lag at most max_versions_behind releases (a diagram touched in the last few releases is acceptable; one that is 19 versions old is exactly the failure this caught).",
    "source_dirs": {
      "SDD/diagrams": "website/sdd/diagrams",
      "docs/images": "website/images"
    },
    "files": [
      {
        "path": "SDD/diagrams/system-context.svg",
        "require": [
          "FTDX10",
          "FTX-1F",
          "IC-705",
          "recordings",
          "MRRC_ALLOW_UNVERIFIED_TX"
        ]
      },
      {
        "path": "SDD/diagrams/layer-architecture.svg",
        "require": [
          "yaesu",
          "ic7300",
          "recorder.py",
          "5 WebSocket"
        ]
      },
      {
        "path": "SDD/diagrams/logical-architecture.svg",
        "require": [
          "backends/yaesu/",
          "backends/ic7300/",
          "recorder.py",
          "atr1000_client.py"
        ]
      },
      {
        "path": "SDD/diagrams/spectrum-paths.svg",
        "require": [
          "FT4222",
          "0x27",
          "no scope stream"
        ]
      },
      {
        "path": "SDD/diagrams/audio-chains.svg",
        "require": [
          "16 kHz",
          "AD-017",
          "48 kHz"
        ]
      },
      {
        "path": "SDD/diagrams/subject-area-model.svg",
        "require": [
          "RecordingSession",
          "RadioBackend",
          "provenance"
        ]
      },
      {
        "path": "SDD/diagrams/ptt-safety-architecture.svg",
        "require": [
          "LAYER 0",
          "MRRC_ALLOW_UNVERIFIED_TX",
          "releases are never gated"
        ]
      },
      {
        "path": "SDD/diagrams/polling-architecture.svg",
        "require": [
          "init_scope",
          "RadioBackend"
        ]
      },
      {
        "path": "SDD/diagrams/atr1000-linkage.svg",
        "require": [
          "ATR1000"
        ]
      },
      {
        "path": "SDD/diagrams/state-broadcasting.svg",
        "require": [
          "dirty"
        ]
      },
      {
        "path": "docs/images/ui-guide-main.svg",
        "require": [
          "REC",
          "PTT"
        ]
      },
      {
        "path": "docs/images/ui-guide-menu.svg",
        "require": [
          "录音 Recordings",
          "MRRC Modern"
        ]
      }
    ],
    "max_versions_behind": 2
  }
}
