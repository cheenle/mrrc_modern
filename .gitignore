# Python virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Logs
logs/
*.log
nohup.out

# Built support bundles (support-out/ is LOG_DIR's sibling — spec 2026-09-17 §7)
support-out/

# Runtime files
.ft710-server.pid

# IDE
.vscode/
.idea/
.worktrees/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Sensitive config (uncomment if needed)
# config_local.py
.env
.env.example

# SSL certificates (contain private keys — do not commit)
# No trailing slash: also ignores the `certs` symlink (-> external dir).
certs
certs/

# Build / distribution artifacts
build/
dist/
.pytest_cache/

# Website download payloads are deployed from verified dist artifacts, not Git.
website/downloads/*.exe

# Vendor binaries (fetch scripts stay tracked)
vendor/ftdi/*.zip
vendor/ftdi/windows/bin/
vendor/opus/

# Promo / media assets
promo/
website/videos/

# Unreferenced local image assets
yagi_*.jpg

# Accidental IDE workspace with backtick in name
FT710Mobile/`.xcodeproj/
website/downloads/*.dmg

# Runtime QSO recordings (server-side MP3s; AD-017 — never commit audio)
recordings/
# 构建输入：由 mrrc_hub/deploy/fetch_installer_payload.sh 按 payload.lock 的哈希复现，
# 不入库（入库的是那份哈希锁，不是 26MB 二进制）。
packaging/payload/

# 补丁构建的暂存目录（由 website/downloads/patches/*.zip 生成，不入库）
packaging/patch/

# Cloud Hub wizard writes the signed cert/key pair + cloud token here (runtime).
mrrc_modern.env
