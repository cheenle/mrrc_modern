# Python virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Logs
logs/
*.log
nohup.out

# Built support bundles (support-out/ is LOG_DIR's sibling — spec 2026-09-17 §7)
support-out/

# Runtime files
.ft710-server.pid

# IDE
.vscode/
.idea/
.worktrees/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Sensitive config (uncomment if needed)
# config_local.py
.env
.env.example

# SSL certificates (contain private keys — do not commit)
# No trailing slash: also ignores the `certs` symlink (-> external dir).
certs
certs/

# Build / distribution artifacts
build/
dist/
.pytest_cache/

# Website download payloads are deployed from verified dist artifacts, not Git.
website/downloads/*.exe
website/downloads/*.apk
website/downloads/*.img.xz

# Vendor binaries (fetch scripts stay tracked)
vendor/ftdi/*.zip
vendor/ftdi/windows/bin/
vendor/opus/

# Promo / media assets
promo/
website/videos/

# Unreferenced local image assets
yagi_*.jpg

# Accidental IDE workspace with backtick in name
FT710Mobile/`.xcodeproj/
website/downloads/*.dmg
# Android APK：由 release.sh 上传服务器，本地镜像不入库（9 MB 二进制）
website/downloads/*.apk

# Runtime QSO recordings (server-side MP3s; AD-017 — never commit audio)
recordings/
# 构建输入：由 mrrc_hub/deploy/fetch_installer_payload.sh 按 payload.lock 的哈希复现，
# 不入库（入库的是那份哈希锁，不是 26MB 二进制）。
packaging/payload/

# 补丁构建的暂存目录（由 website/downloads/patches/*.zip 生成，不入库）
packaging/patch/

# Cloud Hub wizard writes the signed cert/key pair + cloud token here (runtime).
mrrc_modern.env

# Live session tokens (runtime state, never committed)
auth-tokens.json
auth-tokens.json.invalidated-*

# Cloud Hub tunnel binary, fetched at build time by packaging/common/fetch-frpc.sh
# (14.8 MB). stage-tree.sh has excluded /fleet/ since 2026-10-11 after a build
# staged a developer's own copy into an image; ignoring it here stops the same
# machine state from reaching git via `git add -A`.
fleet/

.venv-ml/

# SDRplay 的闭源二进制（Hardware API 3.15）不入库：许可只允许随硬件使用，
# 而且它是 1.2 MB 的厂商产物。构建前跑一次 tools/sdr/fetch_sdrplay_api.sh，
# 服务层在 vendor/sdrplay 缺失时会直接让构建失败（不会静默出一个没有 API 的镜像）。
/vendor/sdrplay/

# NanoVNA 运行期数据（扫描库、state.json、下载的镜像）—— 不进版本控制
nano-data/
