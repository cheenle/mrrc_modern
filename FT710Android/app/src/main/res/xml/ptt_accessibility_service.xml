<?xml version="1.0" encoding="utf-8"?>
<!--
  物理 PTT 的全局按键捕获（后台 / 息屏）。

  两个属性是承重的，缺一不可：
  - canRequestFilterKeyEvents="true" → 服务才有资格收按键；缺了它 onKeyEvent 永远不派发
    （即使 dumpsys accessibility 里显示 requestFilterKeyEvents=true）。
  - accessibilityFlags="flagRequestFilterKeyEvents" → 实际生效开关。
  accessibilityEventTypes 不能写 typeNone/0（AAPT 直接拒绝），写一个无害的窗口状态变化即可；
  feedbackType 也不能为空，否则服务可能不出现在已启用列表里，设置页会显示"未启用"。
  canRetrieveWindowContent="false"：不读屏幕内容，也不需要。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/hw_ptt_service_desc" />
