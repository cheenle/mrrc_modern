# macOS configuration for MRRC FT-710.
# Edit ~/Library/Application Support/MRRC-FT710/ft710.env after first launch.

# Silicon Labs CP210x UART appears on macOS as /dev/cu.SLAB_USBtoUART
# (AppleUSBCDC, built in). Run `ls /dev/cu.*` with the radio connected to confirm.
FT710_SERIAL_PORT=/dev/cu.SLAB_USBtoUART
FT710_BAUD_RATE=38400
FT710_WEB_HOST=127.0.0.1
FT710_WEB_PORT=8888
FT710_WEB_PASSWORD=changeme_please_use_strong_password!
FT710_SCOPE_PORT=
FT710_SCOPE_BAUD=115200
# Leave empty for auto-detect. To lock a device, use a name substring
# (e.g. "USB Audio") or an index from the startup device list.
FT710_AUDIO_RX_DEVICE=
FT710_AUDIO_TX_DEVICE=
# Drop libft4222.dylib / libftd2xx.dylib here for FT4222 true spectrum.
# Absent -> the app falls back to S-meter synthetic spectrum (no crash).
FT710_FTDI_LIB_DIR=vendor/ftdi/macos
#FT710_ATR1000_HOST=
#FT710_ATR1000_PORT=60001
