# macOS configuration for MRRC Modern.
# Edit ~/Library/Application Support/MRRC-Modern/mrrc_modern.env after first launch.
# Legacy FT710_* prefixes are still accepted for backward compatibility;
# MRRC_* takes precedence when both are set.

# ── Radio Model ─────────────────────────────────────────────────────
# 留空 = 首次启动自动探测（FT-710 ASCII CAT / Icom CI-V）。
# 也可手动指定: ft710 / ic7300 / ic7300mk2
MRRC_RADIO_MODEL=

# ── Serial ──────────────────────────────────────────────────────────
# 留空 = 首次启动自动扫描 /dev/cu.*。
MRRC_SERIAL_PORT=
MRRC_BAUD_RATE=38400
# :: = IPv6 双栈（通吃 IPv4/IPv6，可被局域网设备访问）；默认自动生成的强密码已保护登录。
MRRC_WEB_HOST=::
MRRC_WEB_PORT=8888
# 留空 = 首次启动自动生成随机密码（登录页横幅 + 菜单栏 Show Password… 可见）。
MRRC_WEB_PASSWORD=
MRRC_SCOPE_PORT=
MRRC_SCOPE_BAUD=115200
# Leave empty for auto-detect. To lock a device, use a name substring
# (e.g. "USB Audio") or an index from the startup device list.
MRRC_AUDIO_RX_DEVICE=
MRRC_AUDIO_TX_DEVICE=
# Drop libft4222.dylib / libftd2xx.dylib here for FT4222 true spectrum.
# Absent -> the app falls back to S-meter synthetic spectrum (no crash).
MRRC_FTDI_LIB_DIR=vendor/ftdi/macos
#MRRC_ATR1000_HOST=
#MRRC_ATR1000_PORT=60001
