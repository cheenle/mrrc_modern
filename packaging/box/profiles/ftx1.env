# ftx1.env — one profile per registry key (backends.known_models()).
#
# Only the model, plus the explicit transmit gate for hardware-unverified
# models (AD-019 / NFR-067). Baud, serial port and audio device are not
# written here on purpose: the backend derives the first two from its own
# table and firstboot resolves the rest, so a second copy would only be a
# second thing to get wrong. FT-710's FTDI scope libraries live in
# vendor/ftdi/ and are found without configuration (design D-9).
MRRC_RADIO_MODEL=ftx1
MRRC_ALLOW_UNVERIFIED_TX=0
