# flex.env — one profile per registry key (backends.known_models()).
#
# One key for the whole FlexRadio family (6300/6400/6500/6600/6700 and the
# current 8400/8600): the radio describes itself over the SmartSDR API, so
# there is no per-model table here to drift.  No serial port and no USB sound
# card — control, panadapter FFT and audio all travel the LAN.  Leave
# MRRC_FLEX_HOST unset in the profile: the box discovers the radio from its
# UDP 4992 broadcast, and an operator pins an address in 连接设置 when there is
# more than one radio on the wire.
#
# Unverified model (design 2026-11-15, no hardware acceptance yet): transmit
# stays gated and says so, per AD-019 / NFR-067.
MRRC_RADIO_MODEL=flex
MRRC_ALLOW_UNVERIFIED_TX=0
