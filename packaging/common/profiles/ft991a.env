# ft991a.env — one profile per registry key (backends.known_models()).
#
# Only the model. Baud, serial port and audio device are not written here on
# purpose: the backend derives the first two from its own table and firstboot
# resolves the rest, so a second copy would only be a second thing to get wrong.
# FT-710's FTDI scope libraries live in vendor/ftdi/ and are found without
# configuration (design D-9).
#
# No MRRC_ALLOW_UNVERIFIED_TX line: the FT-991A was hardware-verified on
# 2026-11-01 (BG7MWR W103D + FT-991A), so its transmit is not gated and the key
# would only be a second place to get the same fact wrong.
MRRC_RADIO_MODEL=ft991a
