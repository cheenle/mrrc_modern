# g7250.env — one profile per registry key (backends.known_models()).
#
# Only the model. Baud, serial port and audio device are not written here on
# purpose: the backend derives the first two from its own table and firstboot
# resolves the rest, so a second copy would only be a second thing to get wrong.
#
# The G7250's spectrum comes from its LAN IQ stream, which is off unless
# MRRC_G7250_LAN_IP is set (see backends/xiegu/lan_iq.py).  Leaving it unset is
# deliberate in an image that cannot know the radio's address: without it the
# radio still tunes and receives, with the synthetic S-meter waterfall.
#
# Unverified model (spec 2026-11-07): no hardware session has validated the CI-V
# address, meter curves or PTT form yet, so transmit stays gated and says so.
MRRC_RADIO_MODEL=g7250
MRRC_ALLOW_UNVERIFIED_TX=0
