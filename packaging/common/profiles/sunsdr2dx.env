# sunsdr2dx.env — one profile per registry key (backends.known_models()).
#
# Only the model.  The SunSDR2 DX has no serial port and no USB sound card:
# control, RX/TX IQ and telemetry all travel over UDP (50001/50002) to the
# address the operator sets in the connection dialog (MRRC_SUNSDR_HOST,
# with optional MRRC_SUNSDR_LOCAL_HOST).  A baud entry exists in
# config's registry-derived table only to keep the model-save contract; it
# is never used on the wire.
#
# Unverified model (spec 2026-11-08): the hardware acceptance session
# (spans, S-meter sanity, TX into a dummy load) has not happened yet, so
# transmit stays gated and says so.
MRRC_RADIO_MODEL=sunsdr2dx
MRRC_ALLOW_UNVERIFIED_TX=0
