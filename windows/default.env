FT710_SERIAL_PORT=COM3
FT710_BAUD_RATE=38400
FT710_WEB_HOST=127.0.0.1
FT710_WEB_PORT=8888
FT710_WEB_PASSWORD=changeme_please_use_strong_password!
FT710_SCOPE_PORT=
FT710_SCOPE_BAUD=115200
# FT-710's built-in USB sound card enumerates on Windows under a generic
# name: "USB Audio CODEC" or "USB Audio Device" (varies by driver/OS).
# The common substring "USB Audio" matches both forms and is stable across
# reboots (device indices are not). If you have more than one such device
# (e.g. an external digimode interface), replace the name with the device
# index printed in the launcher's startup device list ("PyAudio
# initialized. Available devices:").
FT710_AUDIO_RX_DEVICE=USB Audio
FT710_AUDIO_TX_DEVICE=USB Audio
FT710_FTDI_LIB_DIR=vendor\ftdi\windows\bin\x64
#FT710_ATR1000_HOST=
#FT710_ATR1000_PORT=60001
# HTTPS is ON by default: the launcher generates a throwaway self-signed
# certificate into %LOCALAPPDATA%\MRRC-Modern\certs\ on first run (browser
# warns "untrusted" once — accept it). To use your own certificate instead:
#FT710_SSL_CERT=C:\path\to\fullchain.pem
#FT710_SSL_KEY=C:\path\to\privkey.pem
# To fall back to plain HTTP (localhost-only use):
#FT710_SSL=off
