# mrrc_modern.env — MRRC Modern launcher configuration template.
# The launcher copies this file to %LOCALAPPDATA%\MRRC-Modern\mrrc_modern.env
# on first run. The legacy FT710_* prefixes are still accepted for backward
# compatibility with existing configs; MRRC_* takes precedence when both set.

# ── Radio Model ─────────────────────────────────────────────────────
# Select the radio backend. Default is ft710 (Yaesu FT-710).
#   ft710       Yaesu FT-710            (Yaesu ASCII CAT, FT4222 SPI scope)
#   ic7300      Icom IC-7300            (USB CI-V, 0x27 scope)
#   ic7300mk2   Icom IC-7300MK2         (USB CI-V, 0x27 scope)
# 留空 = 首次启动自动生成/探测
MRRC_RADIO_MODEL=

# ── Serial ──────────────────────────────────────────────────────────
# 留空 = 首次启动自动生成/探测
MRRC_SERIAL_PORT=
# Leave empty = per-model default (FT-710 38400; IC-7300/MK2 115200).
# Set only to match a radio whose CI-V/CAT baud menu is fixed to a
# non-default value; the connection dialog re-aligns it with the model.
MRRC_BAUD_RATE=
MRRC_WEB_HOST=127.0.0.1
MRRC_WEB_PORT=8888
# 留空 = 首次启动自动生成/探测
MRRC_WEB_PASSWORD=
MRRC_SCOPE_PORT=
MRRC_SCOPE_BAUD=115200
# FT-710's built-in USB sound card enumerates on Windows under a generic
# name: "USB Audio CODEC" or "USB Audio Device" (varies by driver/OS).
# The common substring "USB Audio" matches both forms and is stable across
# reboots (device indices are not). If you have more than one such device
# (e.g. an external digimode interface), replace the name with the device
# index printed in the launcher's startup device list ("PyAudio
# initialized. Available devices:").
MRRC_AUDIO_RX_DEVICE=USB Audio
MRRC_AUDIO_TX_DEVICE=USB Audio
MRRC_FTDI_LIB_DIR=vendor\ftdi\windows\bin\x64
#MRRC_ATR1000_HOST=
#MRRC_ATR1000_PORT=60001
# HTTPS is ON by default: the launcher generates a throwaway self-signed
# certificate into %LOCALAPPDATA%\MRRC-Modern\certs\ on first run (browser
# warns "untrusted" once — accept it). To use your own certificate instead:
#MRRC_SSL_CERT=C:\path\to\fullchain.pem
#MRRC_SSL_KEY=C:\path\to\privkey.pem
# To fall back to plain HTTP (localhost-only use):
#MRRC_SSL=off
